# Replace the hostname, certificate paths and office subnet before use.
server {
    listen 443 ssl;
    server_name zendesk-auto.internal.example;
    ssl_certificate /etc/nginx/certs/internal.crt;
    ssl_certificate_key /etc/nginx/certs/internal.key;
    allow 127.0.0.1;
    allow 10.20.0.0/16; # EXAMPLE ONLY: replace with your actual office subnet
    deny all;
    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
