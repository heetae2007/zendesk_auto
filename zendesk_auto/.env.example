# Copy to .env; never commit or share this file after adding secrets.
# Zendesk 로그인(OAuth). 설정하면 웹 로그인 = Zendesk 계정이 되고 아래 ADMIN_PASSWORD·API 토큰은 쓰지 않습니다.
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
# 요청할 권한(비우면 기본값). OAuth 클라이언트의 허용 범위에 모두 있어야 합니다.
# 기본: read tickets:write (티켓 검색은 세부 읽기 권한으로는 403이라 전체 읽기 필요)
ZENDESK_OAUTH_SCOPE=
# 이지엣지 접속 주소. Zendesk OAuth 클라이언트의 리디렉션 URL = PUBLIC_URL + /auth/callback
PUBLIC_URL=http://127.0.0.1:8080
# OAuth 설정 전에만 사용
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATA_DIR=./data
STORE_MODE=local
GOOGLE_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/opt/zendesk-auto/secrets/google-service-account.json
ZENDESK_SUBDOMAIN=edgennext
# OAuth 설정 전에만 사용 (Zendesk API 토큰은 2027-04-30 사용 중지)
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# 용도별 모델(비우면 ANTHROPIC_MODEL). 예: 티켓 분석 claude-haiku-5-5, 이미지 claude-sonnet-5-5
ANTHROPIC_MODEL_TICKET=
# 이미지 분석(배정표 스크린샷, 티켓 첨부). 예전 이름 ANTHROPIC_MODEL_SCHEDULE도 인식
ANTHROPIC_MODEL_IMAGE=
# Claude 5.x 모델의 사고량(low/medium/high). 기본 low
ANTHROPIC_EFFORT=low
ANTHROPIC_WORKSPACE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Server-side switch for real Zendesk intake. The web setting must ALSO be turned on.
ALLOW_LIVE_WRITES=false
