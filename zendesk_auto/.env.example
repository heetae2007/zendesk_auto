# Copy to .env; never commit or share this file after adding secrets.
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATA_DIR=./data
STORE_MODE=local
GOOGLE_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/opt/zendesk-auto/secrets/google-service-account.json
ZENDESK_SUBDOMAIN=edgennext
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_WORKSPACE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Server-side switch for real Zendesk intake. The web setting must ALSO be turned on.
ALLOW_LIVE_WRITES=false
